# Copy to .env and fill in. .env is git-ignored: it holds the tunnel token (a secret).
# Read by cloudflared-tray.ps1 (tray app) and cloudflare\*.ps1 (wrangler setup scripts).

# --- Secret ---------------------------------------------------------------
# The tunnel's connector token. Dashboard: Zero Trust > Networks > Tunnels > <tunnel> > Configure
# (the long string after --token in the install command).
TUNNEL_TOKEN=

# --- Cloudflare account ---------------------------------------------------
# Dashboard: Workers & Pages overview (right sidebar), or `npx wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# --- Tunnel ---------------------------------------------------------------
TUNNEL_NAME=my-tunnel
# Filled in by cloudflare\setup.ps1 when it creates the tunnel.
TUNNEL_ID=

# --- Workers VPC service (lets a Worker reach a service on this PC through the tunnel) ---
VPC_SERVICE_NAME=tasks
# Where the service listens, as seen from this PC.
# 127.0.0.1, not localhost: localhost can resolve to IPv6 (::1) first, which most local services do not listen on.
VPC_SERVICE_HOSTNAME=127.0.0.1
VPC_SERVICE_HTTP_PORT=
# Filled in by cloudflare\setup.ps1 when it creates the VPC service.
VPC_SERVICE_ID=
# The Worker that uses the VPC service (for reference).
WORKER_URL=

# --- Tray app -------------------------------------------------------------
APP_NAME=Tasks tunnel
# Publisher stamped into cloudflared-tray.exe (Task Manager, file properties). Rebuild with build-tray.ps1 after changing.
APP_PUBLISHER=Cloudflared Tray
TUNNEL_PROTOCOL=http2
METRICS_PORT=20251
